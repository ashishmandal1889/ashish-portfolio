# ===================================================================
# Spring Boot Environment Variables Example
# Duplicate this file as .env (or configure in your deployment platform)
# DO NOT commit real secrets to source control.
# ===================================================================

# Active Spring Profile: 'local' (PostgreSQL) or 'prod' (MongoDB Atlas)
SPRING_PROFILES_ACTIVE=local

# -------------------------------------------------------------------
# Local Development (PostgreSQL) - Required when SPRING_PROFILES_ACTIVE=local
# -------------------------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/portfolio_db
DB_USERNAME=postgres
DB_PASSWORD=your_local_postgres_password

# -------------------------------------------------------------------
# Production Deployment (MongoDB Atlas) - Required when SPRING_PROFILES_ACTIVE=prod
# -------------------------------------------------------------------
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-address>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=portfolio_db

# -------------------------------------------------------------------
# Security & Authentication (Required for both environments)
# -------------------------------------------------------------------
# Must be at least 32 characters (256 bits) for HMAC-SHA256
JWT_SECRET=your_secure_random_jwt_secret_key_minimum_32_chars_long

# Initial administrator password for default 'Ashish' account
ADMIN_PASSWORD=your_secure_admin_password
